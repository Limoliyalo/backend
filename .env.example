# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthity
DB_USER=postgres
DB_PASSWORD=change_me
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_WEB_PORT=15672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
# Optional: used by some RabbitMQ images / compose defaults
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=change_me
APPLICATION_ADMIN_TELEGRAM_IDS=

# --- NATS (Taskiq JetStream broker) ---
# Local dev: nats://localhost:4222
# Docker Compose (worker + nats in same network): nats://nats:4222
NATS_URL=nats://localhost:4222

# --- JWT ---
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
