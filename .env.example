# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthity
DB_USER=healthity
DB_PASSWORD=change_me_strong_password
DB_ECHO=false
DB_HOST_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password
REDIS_HOST_PORT=6378

# --- RabbitMQ ---
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_WEB_PORT=15672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
# Optional: used by some RabbitMQ images / compose defaults
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=change_me
NOTIFICATIONS_ACCESS_TOKEN=
APPLICATION_ADMIN_TELEGRAM_IDS=

# --- App security / runtime ---
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://healthity.ru,https://healthity.web.app,https://healthity.firebaseapp.com,http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010
LOG_LEVEL=INFO

# --- NATS (Taskiq JetStream broker) ---
# Local dev: nats://localhost:4222
# Docker Compose (worker + nats in same network): nats://nats:4222
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- JWT ---
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
